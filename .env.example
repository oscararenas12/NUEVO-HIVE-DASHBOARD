# Copy to .env and fill in local values. .env is gitignored -- never commit real creds.
# These are LOCAL DEV credentials for docker-compose; production must inject real
# secrets via the environment / a secrets manager.

POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=hive_dev

# Running the backend tests locally against the api-db container (host port 5436):
#   export DATABASE_TEST_URL=postgresql://your_db_user:your_db_password@localhost:5436/hive_test
